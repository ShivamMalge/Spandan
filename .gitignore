# Generated event streams only. Root-anchored on purpose: a bare `data/` pattern
# would also match any nested data directory, and PHASES.md Phase 3 requires
# tests/fixtures/parity.json to be committed. Phase 0 asserts tests/fixtures is
# not ignored.
/data/

# Rust
/spandan-core/target/
/target/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
venv/

# Compiled extension module, produced by `maturin develop`
*.pyd
*.so
*.dylib
*.pdb
*.dll.lib

# Stray duplicates of tracked docs, pending a decision on their fate.
# NOT deleted (agents.md 1) - they remain on disk in docs/.
docs/*.md.bak